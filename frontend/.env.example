# Base URL of the FastAPI backend. Also used to build the Content-Security-Policy
# connect-src rule (see next.config.mjs), so it must be the exact origin the
# browser calls -- e.g. https://api.yourdomain.com in production.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional. Set to "true" on a first deploy to send the CSP as report-only
# (violations are logged in the browser console but nothing is blocked).
# Remove it once the console is clean to start enforcing the policy.
# CSP_REPORT_ONLY=true
