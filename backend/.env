# --- App ---
APP_NAME="Mayorcity Bizintel"
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://bizintel_user:bizintel_pass@localhost:5432/bizintel_db

# --- Auth / JWT ---
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# --- AI assistant ---
# Required for the POST /businesses/{business_id}/assistant/messages route.
# Leave blank in environments that don't need the assistant; that route
# will return a 503 rather than the app failing to start.
# Get a key at https://console.groq.com -- NEVER commit a real key here,
# this file is just documentation of what .env needs.
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
