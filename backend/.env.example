# --- App ---
APP_NAME="Mayorcity Bizintel"
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://bizintel_user:bizintel_pass@localhost:5432/bizintel_db

# --- Auth / JWT ---
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# --- AI assistant ---
# Required for the POST /businesses/{business_id}/assistant/messages route.
# Leave blank in environments that don't need the assistant; that route
# will return a 503 rather than the app failing to start.
# Get a key at https://console.groq.com -- NEVER commit a real key here,
# this file is just documentation of what .env needs.
GROQ_API_KEY=
# llama-3.3-70b-versatile and llama-3.1-8b-instant are Enterprise-only as
# of Aug 2026 -- use a general-access production model instead.
GROQ_MODEL=openai/gpt-oss-120b

# --- Logging & error monitoring (Step 10, Batch 10.8) ---
# "json" in production (one parseable object per line, for your log
# aggregator); "text" is easier to read directly in a local dev terminal.
LOG_FORMAT=text
LOG_LEVEL=INFO
# Leave blank to run with no error-monitoring service (the default --
# fine for local/dev). Set to a real DSN in production to get exception
# tracking. Get one at https://sentry.io -- NEVER commit a real DSN here,
# this file is just documentation of what .env needs.
SENTRY_DSN=
# Fraction (0.0-1.0) of requests sampled for performance tracing. Errors
# are always captured regardless of this value.
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Data retention (Step 10, Batch 10.10) ---
# See docs/BACKUP_RECOVERY.md for the full policy. AuditLog is kept
# indefinitely and has no retention setting by design.
DATA_RETENTION_INTERVAL_HOURS=24
IMPORT_RAW_ROWS_RETENTION_DAYS=30
BACKGROUND_JOB_RETENTION_DAYS=90

# --- Microsoft Excel/OneDrive integration (Step 11, Batch 11.9) ---
# Empty by default so this app boots and runs fully without a Microsoft
# app registration; the /microsoft/connect route raises a clear 503 if
# these are unset. Get these from an app registration in Azure Portal >
# App registrations, with the Microsoft Graph "Files.Read" and
# "User.Read" delegated permissions granted.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the app registration,
# and must point at this backend's own /microsoft/callback route (not
# the frontend).
MICROSOFT_REDIRECT_URI=
# Fernet key encrypting Microsoft tokens at rest -- can reuse the same
# key as GOOGLE_TOKEN_ENCRYPTION_KEY, or generate a separate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MICROSOFT_TOKEN_ENCRYPTION_KEY=
MICROSOFT_SYNC_INTERVAL_HOURS=6
