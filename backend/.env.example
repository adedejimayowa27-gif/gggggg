# Copy to backend/.env and fill in. NEVER commit the real .env -- this file
# is just documentation of every setting the app reads (see app/core/config.py).
# Only DATABASE_URL and SECRET_KEY are required; everything else is optional
# and the related feature simply returns a clear 503 (or no-ops) when unset.

# --- App ---
APP_NAME="Mayorcity Bizintel"
# "development" locally, "production" when deployed.
ENVIRONMENT=development
# MUST be false in production: debug mode exposes detailed error pages.
DEBUG=true

# --- Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# The values below match docker-compose.yml for local development only.
DATABASE_URL=postgresql://bizintel_user:bizintel_pass@localhost:5432/bizintel_db

# --- Auth / JWT ---
# Signs login and password-reset tokens. Use a long random value and keep it
# secret; changing it logs everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
# Short on purpose: real sessions are kept alive by refresh tokens (see
# REFRESH_TOKEN_EXPIRE_DAYS below), which the frontend renews before this
# expires. A logged-in user never notices.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# How long a refresh token stays valid without being used. Each call to
# POST /auth/refresh issues a new one (rotation), so an active session
# effectively never expires -- this is really "how long can someone stay
# logged out before they need to log in again."
REFRESH_TOKEN_EXPIRE_DAYS=30
# How long a password-reset link stays valid.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS / frontend ---
# Comma-separated list of allowed browser origins. In production set this to
# your real frontend origin only, e.g. https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000
# Where the user's browser is sent after an OAuth callback, and the base URL
# used in emailed links (password reset, team invites).
FRONTEND_URL=http://localhost:3000

# --- AI assistant ---
# Required for the POST /businesses/{business_id}/assistant/messages route.
# Leave blank in environments that don't need the assistant; that route
# will return a 503 rather than the app failing to start.
# Get a key at https://console.groq.com -- NEVER commit a real key here.
GROQ_API_KEY=
# llama-3.3-70b-versatile and llama-3.1-8b-instant are Enterprise-only as
# of Aug 2026 -- use a general-access production model instead.
GROQ_MODEL=openai/gpt-oss-120b

# --- Transactional email (password reset, team invites, alert emails) ---
# Leave blank and emails are logged instead of sent; nothing crashes.
# Get a key at https://resend.com
RESEND_API_KEY=
# Must be a verified sender in your Resend account, or sends are rejected.
EMAIL_FROM_ADDRESS="BizIntel <onboarding@resend.dev>"
# How long a "confirm your email" link stays valid, in minutes (default 24h).
# Not security-critical like the password-reset window above -- a stale
# link is just resent, nothing is gated on this (see app/api/routes/auth.py).
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# --- Google Sheets integration (Step 9) ---
# Create an OAuth 2.0 Client in Google Cloud Console (APIs & Services >
# Credentials) with the Sheets API and Drive API enabled. The app only
# requests read-only scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client and point
# at this backend's /google/callback route (not the frontend).
GOOGLE_REDIRECT_URI=
# Encrypts stored Google tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or rotating this key forces every user to reconnect Google.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Microsoft Excel/OneDrive integration (Step 11, Batch 11.9) ---
# Azure Portal > App registrations, with the Microsoft Graph "Files.Read" and
# "User.Read" delegated permissions granted.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Must exactly match a registered redirect URI and point at this backend's
# /microsoft/callback route (not the frontend).
MICROSOFT_REDIRECT_URI=
# Can reuse GOOGLE_TOKEN_ENCRYPTION_KEY, or generate a separate one with the
# same command shown above.
MICROSOFT_TOKEN_ENCRYPTION_KEY=

# --- Billing (Step 10) ---
# Blank = every business stays on the free plan and the checkout route
# returns a clean 503 "billing_not_configured". Payments are not live yet.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Background jobs (Step 10, Batch 10.7) ---
# In-process scheduler. If you ever run more than one backend instance, each
# would run these jobs on its own (harmless but wasteful).
ENABLE_BACKGROUND_JOBS=true
ALERT_DETECTION_INTERVAL_HOURS=24
GOOGLE_SYNC_INTERVAL_HOURS=6
MICROSOFT_SYNC_INTERVAL_HOURS=6

# --- Data retention (Step 10, Batch 10.10) ---
# See docs/BACKUP_RECOVERY.md for the full policy. AuditLog is kept
# indefinitely and has no retention setting by design.
DATA_RETENTION_INTERVAL_HOURS=24
IMPORT_RAW_ROWS_RETENTION_DAYS=30
BACKGROUND_JOB_RETENTION_DAYS=90

# --- Logging & error monitoring (Step 10, Batch 10.8) ---
# "json" in production (one parseable object per line); "text" is easier to
# read in a local terminal.
LOG_FORMAT=text
LOG_LEVEL=INFO
# Leave blank to run without error monitoring. Get a DSN at https://sentry.io
SENTRY_DSN=
# Fraction (0.0-1.0) of requests sampled for performance tracing. Errors are
# always captured regardless of this value.
SENTRY_TRACES_SAMPLE_RATE=0.1
